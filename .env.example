# MongoDB connection string used by Prisma (see prisma/schema.prisma).
# Must point at a replica set — Prisma's MongoDB connector requires one, even for local dev.
# Local example:  mongodb://localhost:27017/airline_reservation?replicaSet=rs0
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airline_reservation?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/airline_reservation?replicaSet=rs0"
