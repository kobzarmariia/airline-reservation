# MongoDB connection string used by Prisma (see prisma/schema.prisma).
# Must point at a replica set — Prisma's MongoDB connector requires one, even for local dev.
# Local example:  mongodb://localhost:27017/airline_reservation?replicaSet=rs0
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airline_reservation?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/airline_reservation?replicaSet=rs0"

# Elasticsearch node used for the flight search read model (see
# src/modules/flight/infrastructure/search). Mongo remains the system of
# record; this index is rebuilt by `npm run db:seed` and kept in sync
# incrementally as seats are held/confirmed/released.
ELASTICSEARCH_NODE="http://localhost:9200"

# Neo4j route graph read model (see src/modules/flight/infrastructure/graph).
# Mongo remains the system of record; this graph is rebuilt on demand by
# `npm run graph:seed:neo4j`.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
