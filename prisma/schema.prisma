generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type SeatModel {
  seatNumber    String
  seatClass     String // "ECONOMY" | "BUSINESS" | "FIRST"
  price         Float     @default(0)
  status        String // "AVAILABLE" | "HELD" | "OCCUPIED"
  holdId        String?
  holdExpiresAt DateTime?
}

type PassengerModel {
  firstName      String
  lastName       String
  email          String
  passportNumber String?
}

type MoneyModel {
  amount   Int
  currency String
}

type SeatAssignmentModel {
  seatNumber String
  passenger  PassengerModel
  price      MoneyModel
}

model ReservationModel {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  domainId String @unique

  flightId String
  holdId   String
  status   String // "PENDING" | "CONFIRMED" | "CANCELLED" | "EXPIRED"

  seatAssignments SeatAssignmentModel[]
  totalPrice      MoneyModel

  holdExpiresAt      DateTime
  paymentId          String?
  cancellationReason String?

  // Optimistic concurrency control: bumped on every successful write so
  // concurrent writers that read the same version can detect a lost update.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([flightId])
  @@index([holdId])
  @@index([status, holdExpiresAt])
  @@map("reservations")
}

model FlightModel {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  domainId     String @unique
  flightNumber String

  // Flat route & schedule fields
  originAirport String
  destAirport   String
  departureTime DateTime
  arrivalTime   DateTime

  // Capacity stored as raw numbers
  economyCapacity  Int @default(0)
  businessCapacity Int @default(0)
  firstCapacity    Int @default(0)

  // Embedded seats array
  seats SeatModel[]

  // Optimistic concurrency control: bumped on every successful write so
  // concurrent writers that read the same version can detect a lost update.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([flightNumber])
  @@index([departureTime])
  @@map("flights")
}
